@{
    ViewData["Title"] = "Smart Placement Management System";
}

<div class="hero-section">

    <div class="hero-content">

        <h1>Smart Placement Management System</h1>

        <p>
            Connecting Students, Companies and Placement Officers
            on one platform.
        </p>

        <div class="hero-buttons">

            <a href="/Student/Login"
               class="btn-primary-custom">
                🎓 Student Login
            </a>

            <a href="/Company/Login"
               class="btn-secondary-custom">
                🏢 Company Login
            </a>

            <a href="/PlacementOfficer/Login"
               class="btn-secondary-custom">
                📊 Placement Officer
            </a>

        </div>

    </div>

</div>


<div class="features-section">

    <h2>Our Platform</h2>

    <p class="platform-subtitle">
        A complete placement management platform for students,
        companies and placement officers.
    </p>


    <div class="feature-container">


        <!-- STUDENTS -->

        <a href="/Student/Login"
           class="feature-card">

            <div class="icon">🎓</div>

            <h3>Students</h3>

            <p>
                Create your profile, explore jobs,
                apply for opportunities and track applications.
            </p>

            <span class="feature-link">
                Student Portal →
            </span>

        </a>


        <!-- COMPANIES -->

        <a href="/Company/Login"
           class="feature-card">

            <div class="icon">🏢</div>

            <h3>Companies</h3>

            <p>
                Post job opportunities, find eligible students
                and manage applications.
            </p>

            <span class="feature-link">
                Company Portal →
            </span>

        </a>


        <!-- PLACEMENT OFFICER -->

        <a href="/PlacementOfficer/Login"
           class="feature-card">

            <div class="icon">📊</div>

            <h3>Placement Officer</h3>

            <p>
                Manage students, companies, placement drives
                and placement statistics.
            </p>

            <span class="feature-link">
                Officer Portal →
            </span>

        </a>


    </div>

</div>
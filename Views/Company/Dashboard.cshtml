@{
    ViewData["Title"] = "Company Dashboard";
}

<div class="company-dashboard">

    <div class="dashboard-header">

        <div class="header-top">

            <div>
                <h1>
                    Welcome, @(ViewBag.CompanyName ?? "Company")! 🏢
                </h1>

                <p>
                    Your SmartPlacement Company Dashboard
                </p>
            </div>

            <a href="/Company/Logout"
               class="logout-btn">
                Logout
            </a>

        </div>

    </div>


    <div class="dashboard-stats">

        <div class="stat-card">
            <div class="stat-icon">📢</div>
            <h3>@ViewBag.JobCount</h3>
            <p>Jobs Posted</p>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📄</div>
            <h3>@ViewBag.ApplicationCount</h3>
            <p>Applications</p>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🎓</div>
            <h3>@ViewBag.StudentCount</h3>
            <p>Students</p>
        </div>

    </div>


    <div class="dashboard-actions">

        <a href="/Company/PostJob" class="dashboard-card">

            <div class="action-icon">📢</div>

            <h2>Post Jobs</h2>

            <p>
                Create and publish new job opportunities
                for students.
            </p>

        </a>


        <a href="/Company/Jobs" class="dashboard-card">

            <div class="action-icon">💼</div>

            <h2>My Posted Jobs</h2>

            <p>
                View all jobs posted by your company.
            </p>

        </a>


        <a href="/Company/Applications" class="dashboard-card">

            <div class="action-icon">📄</div>

            <h2>Applications</h2>

            <p>
                View and manage applications
                received from students.
            </p>

        </a>


        <a href="/Company/Students" class="dashboard-card">

            <div class="action-icon">👥</div>

            <h2>Students</h2>

            <p>
                Find students for your job opportunities.
            </p>

        </a>

    </div>


    <a href="/" class="back-home">
        ← Back to Home
    </a>

</div>


<style>

    .company-dashboard {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }


    .dashboard-header {
        margin-bottom: 35px;
    }


    .header-top {
        background: linear-gradient(135deg, #172554, #2563eb);
        color: white;
        padding: 35px;
        border-radius: 22px;

        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }


    .header-top h1 {
        font-size: 38px;
        margin: 0 0 8px;
    }


    .header-top p {
        font-size: 18px;
        margin: 0;
        opacity: 0.9;
    }


    .logout-btn {
        display: inline-block;
        padding: 12px 25px;
        background: white;
        color: #1d4ed8;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 700;
        white-space: nowrap;
        transition: 0.2s;
    }


    .logout-btn:hover {
        background: #eff6ff;
        transform: translateY(-2px);
    }


    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }


    .stat-card {
        background: white;
        padding: 25px;
        text-align: center;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }


    .stat-icon {
        font-size: 35px;
    }


    .stat-card h3 {
        font-size: 30px;
        margin: 8px 0;
    }


    .stat-card p {
        margin: 0;
        color: #666;
    }


    .dashboard-actions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }


    .dashboard-card {
        display: block;
        background: white;
        padding: 28px;
        border-radius: 16px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: 0.2s;
    }


    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    }


    .action-icon {
        font-size: 35px;
        margin-bottom: 10px;
    }


    .dashboard-card h2 {
        margin: 5px 0 10px;
    }


    .dashboard-card p {
        color: #666;
        line-height: 1.5;
        margin: 0;
    }


    .back-home {
        display: inline-block;
        margin-top: 30px;
        color: #0d6efd;
        text-decoration: none;
        font-weight: 600;
    }


    @@media (max-width: 700px) {

        .header-top {
            flex-direction: column;
            text-align: center;
        }

        .header-top h1 {
            font-size: 30px;
        }

        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .dashboard-actions {
            grid-template-columns: 1fr;
        }

    }

</style>
@model IEnumerable<SmartPlacement.Models.Application>

@{
    ViewData["Title"] = "Applications";
}

<div class="dashboard">

    <h1>📄 Student Applications</h1>

    <p>Review and manage applications received for your jobs.</p>

    @if (Model != null && Model.Any())
    {
        <div class="applications-container">

            @foreach (var application in Model)
            {
                <div class="application-card">

                    <div class="application-header">

                        <div>
                            <h2>🎓 @application.StudentName</h2>

                            <p class="job-title">
                                Applied for:
                                <strong>@application.JobTitle</strong>
                            </p>
                        </div>

                        <span class="status @application.Status.ToLower()">
                            @application.Status
                        </span>

                    </div>


                    <div class="application-info">

                        <p>
                            <strong>Company:</strong>
                            @application.CompanyName
                        </p>

                        <p>
                            <strong>Applied Date:</strong>
                            @application.AppliedDate
                        </p>

                        <p>
                            <strong>Application ID:</strong>
                            #@application.Id
                        </p>

                    </div>


                    <!-- Resume -->

                    <div class="resume-section">

                        <div class="resume-title">
                            📄 Resume
                        </div>

                        @if (!string.IsNullOrWhiteSpace(application.ResumeFileName))
                        {
                            <a href="/resumes/@application.ResumeFileName"
                               target="_blank"
                               class="resume-btn">
                                👁️ View Resume
                            </a>

                            <a href="/resumes/@application.ResumeFileName"
                               download
                               class="download-btn">
                                ⬇️ Download Resume
                            </a>
                        }
                        else
                        {
                            <span class="no-resume">
                                Resume not available
                            </span>
                        }

                    </div>


                    <div class="application-actions">

                        @if (application.Status == "Applied")
                        {
                            <form method="post"
                                  action="/Company/Shortlist">

                                <input type="hidden"
                                       name="applicationId"
                                       value="@application.Id" />

                                <button type="submit"
                                        class="shortlist-btn">
                                    ✓ Shortlist
                                </button>

                            </form>


                            <form method="post"
                                  action="/Company/Reject">

                                <input type="hidden"
                                       name="applicationId"
                                       value="@application.Id" />

                                <button type="submit"
                                        class="reject-btn">
                                    ✕ Reject
                                </button>

                            </form>
                        }
                        else if (application.Status == "Shortlisted")
                        {
                            <div class="selected-message">
                                ✓ Student Shortlisted
                            </div>
                        }
                        else if (application.Status == "Rejected")
                        {
                            <div class="rejected-message">
                                ✕ Application Rejected
                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-message">

            <div class="empty-icon">📭</div>

            <h2>No Applications Yet</h2>

            <p>
                Students have not applied for your jobs yet.
            </p>

        </div>
    }

    <br />

    <a href="/Company/Dashboard"
       class="edit-profile-btn">
        ← Back to Company Dashboard
    </a>

</div>


<style>

    .applications-container {
        display: grid;
        gap: 20px;
        margin-top: 30px;
    }

    .application-card {
        background: white;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .application-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .application-header h2 {
        margin: 0 0 8px;
    }

    .job-title {
        margin: 0;
    }

    .status {
        padding: 8px 14px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status.applied {
        background: #fff3cd;
        color: #856404;
    }

    .status.shortlisted {
        background: #d4edda;
        color: #155724;
    }

    .status.rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .application-info {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }

    .application-info p {
        margin: 8px 0;
    }

    .resume-section {
        margin-top: 20px;
        padding: 18px;
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .resume-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .resume-btn,
    .download-btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin-right: 8px;
        margin-bottom: 5px;
    }

    .resume-btn {
        background: #2563eb;
        color: white;
    }

    .download-btn {
        background: #198754;
        color: white;
    }

    .resume-btn:hover {
        background: #1d4ed8;
    }

    .download-btn:hover {
        background: #157347;
    }

    .no-resume {
        color: #777;
        font-style: italic;
    }

    .application-actions {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .application-actions form {
        margin: 0;
    }

    .shortlist-btn,
    .reject-btn {
        border: none;
        padding: 11px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
    }

    .shortlist-btn {
        background: #198754;
        color: white;
    }

    .reject-btn {
        background: #dc3545;
        color: white;
    }

    .selected-message {
        padding: 11px 18px;
        border-radius: 8px;
        background: #d4edda;
        color: #155724;
        font-weight: 600;
    }

    .rejected-message {
        padding: 11px 18px;
        border-radius: 8px;
        background: #f8d7da;
        color: #721c24;
        font-weight: 600;
    }

    .empty-message {
        background: white;
        padding: 50px 30px;
        margin-top: 30px;
        border-radius: 16px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

</style>
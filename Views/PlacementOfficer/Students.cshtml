@model IEnumerable<SmartPlacement.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="students-page">

    <div class="students-header">
        <h1>🎓 Students</h1>
        <p>View and monitor registered students.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="students-container">

            @foreach (var student in Model)
            {
                <div class="student-card">

                    <div class="student-icon">
                        👤
                    </div>

                    <div class="student-info">

                        <h2>@student.FullName</h2>

                        <p>
                            <strong>Email:</strong>
                            @student.Email
                        </p>

                        <p>
                            <strong>Phone:</strong>
                            @student.Phone
                        </p>

                        <p>
                            <strong>College:</strong>
                            @student.College
                        </p>

                        <p>
                            <strong>Course:</strong>
                            @student.Course
                        </p>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-students">
            <div>🎓</div>
            <h2>No Students Registered</h2>
            <p>Registered students will appear here.</p>
        </div>
    }

    <a asp-controller="PlacementOfficer"
       asp-action="Dashboard"
       class="back-btn">
        ← Back to Dashboard
    </a>

</div>

<style>

    .students-page {
        max-width: 1100px;
        margin: 50px auto;
        padding: 20px;
    }

    .students-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .students-header h1 {
        font-size: 42px;
        margin-bottom: 10px;
        color: #172554;
    }

    .students-header p {
        font-size: 18px;
        color: #64748b;
    }

    .students-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .student-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        display: flex;
        gap: 22px;
        border: 1px solid #e5e7eb;
    }

    .student-icon {
        font-size: 45px;
        width: 70px;
        height: 70px;
        background: #eff6ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .student-info h2 {
        margin: 0 0 15px;
        color: #172554;
    }

    .student-info p {
        margin: 8px 0;
        color: #475569;
        font-size: 15px;
    }

    .empty-students {
        text-align: center;
        background: white;
        padding: 60px 20px;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .empty-students div {
        font-size: 60px;
        margin-bottom: 15px;
    }

    .empty-students h2 {
        color: #172554;
    }

    .empty-students p {
        color: #64748b;
    }

    .back-btn {
        display: inline-block;
        margin-top: 30px;
        padding: 12px 22px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
    }

    .back-btn:hover {
        background: #1d4ed8;
    }

    @@media (max-width: 700px) {

        .students-container {
            grid-template-columns: 1fr;
        }

        .students-header h1 {
            font-size: 32px;
        }

        .student-card {
            flex-direction: column;
        }

    }

</style>
@{
    ViewData["Title"] = "Placement Officer Dashboard";
}

<div class="officer-page">

    <div class="hero">
        <div class="hero-icon">🏫</div>

        <h1>Placement Officer Dashboard</h1>

        <p>
            Manage and monitor the complete placement process.
        </p>

        <a href="/PlacementOfficer/Logout" class="logout-btn">
            Logout
        </a>
    </div>


    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon">🎓</div>
            <div class="stat-number">@ViewBag.StudentCount</div>
            <div class="stat-title">Students</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🏢</div>
            <div class="stat-number">@ViewBag.CompanyCount</div>
            <div class="stat-title">Companies</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">💼</div>
            <div class="stat-number">@ViewBag.JobCount</div>
            <div class="stat-title">Jobs Posted</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📄</div>
            <div class="stat-number">@ViewBag.ApplicationCount</div>
            <div class="stat-title">Applications</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-number">@ViewBag.ShortlistedCount</div>
            <div class="stat-title">Shortlisted</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">❌</div>
            <div class="stat-number">@ViewBag.RejectedCount</div>
            <div class="stat-title">Rejected</div>
        </div>

    </div>


    <div class="actions-section">

        <h2>Placement Management</h2>

        <p>
            Access and monitor placement information.
        </p>

        <div class="action-grid">

            <a href="/PlacementOfficer/Students" class="action-card">
                <span class="action-icon">🎓</span>

                <h3>Students</h3>

                <p>
                    View registered students and their information.
                </p>

                <span class="action-link">
                    View Students →
                </span>
            </a>


            <a href="/PlacementOfficer/Companies" class="action-card">
                <span class="action-icon">🏢</span>

                <h3>Companies</h3>

                <p>
                    View companies participating in placements.
                </p>

                <span class="action-link">
                    View Companies →
                </span>
            </a>


            <a href="/PlacementOfficer/Jobs" class="action-card">
                <span class="action-icon">💼</span>

                <h3>Jobs</h3>

                <p>
                    View all job opportunities posted by companies.
                </p>

                <span class="action-link">
                    View Jobs →
                </span>
            </a>


            <a href="/PlacementOfficer/Applications" class="action-card">
                <span class="action-icon">📄</span>

                <h3>Applications</h3>

                <p>
                    Monitor applications submitted by students.
                </p>

                <span class="action-link">
                    View Applications →
                </span>
            </a>

        </div>

    </div>

</div>


<style>

    .officer-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 45px 25px 70px;
    }

    .hero {
        background: linear-gradient(135deg, #172554, #2563eb);
        color: white;
        border-radius: 24px;
        padding: 50px 35px;
        text-align: center;
        margin-bottom: 35px;
    }

    .hero-icon {
        font-size: 55px;
        margin-bottom: 10px;
    }

    .hero h1 {
        font-size: 38px;
        margin: 5px 0 12px;
    }

    .hero p {
        font-size: 18px;
        margin-bottom: 25px;
        opacity: 0.9;
    }

    .logout-btn {
        display: inline-block;
        background: white;
        color: #1d4ed8;
        padding: 11px 25px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 45px;
    }

    .stat-card {
        background: white;
        border-radius: 18px;
        padding: 28px 20px;
        text-align: center;
        box-shadow: 0 7px 25px rgba(0,0,0,0.08);
    }

    .stat-icon {
        font-size: 38px;
        margin-bottom: 10px;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 800;
        color: #172033;
    }

    .stat-title {
        color: #667085;
        font-size: 16px;
        margin-top: 5px;
    }

    .actions-section {
        text-align: center;
    }

    .actions-section h2 {
        font-size: 30px;
        margin-bottom: 8px;
        color: #172033;
    }

    .actions-section > p {
        color: #667085;
        margin-bottom: 28px;
    }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .action-card {
        background: white;
        padding: 30px;
        border-radius: 18px;
        text-align: left;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 7px 25px rgba(0,0,0,0.08);
        transition: transform 0.2s;
    }

    .action-card:hover {
        transform: translateY(-4px);
    }

    .action-icon {
        font-size: 40px;
    }

    .action-card h3 {
        font-size: 23px;
        margin: 12px 0 8px;
        color: #172033;
    }

    .action-card p {
        color: #667085;
        line-height: 1.5;
        margin-bottom: 18px;
    }

    .action-link {
        color: #2563eb;
        font-weight: 700;
    }


    @@media (max-width: 700px) {

        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .action-grid {
            grid-template-columns: 1fr;
        }

        .hero h1 {
            font-size: 30px;
        }

    }


    @@media (max-width: 450px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .officer-page {
            padding: 25px 15px 50px;
        }

    }

</style>